<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^$ public/ [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Protect sensitive files and storage
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

RedirectMatch 403 ^.*/storage/.*$
RedirectMatch 403 ^.*/database/.*$
